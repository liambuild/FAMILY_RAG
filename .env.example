# ─── Chemin vers les documents sur l'hôte ────────────────────────────────────
# Dossier contenant les fichiers à indexer (PDF, DOCX, images…)
HOST_DATA_PATH=/chemin/vers/vos/documents

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Mac / Windows (Docker Desktop) : host.docker.internal:11434
# Linux : fixé à 127.0.0.1:11434 par docker-compose.linux.yml (cette valeur est alors ignorée)
OLLAMA_HOST=host.docker.internal:11434

# Modèle d'embedding (doit être disponible dans Ollama)
EMBEDDING_MODEL=nomic-embed-text

# Modèle LLM (laisser vide pour auto-détection au démarrage)
LLM_MODEL=

# ─── Paramètres RAG ───────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=300
TOP_K=12

# ─── LLM ──────────────────────────────────────────────────────────────────────
TEMPERATURE=0.7
